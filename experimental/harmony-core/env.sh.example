# Source this file before HarmonyOS development.
export MAA_HARMONY_HOME="$HOME/Maindome/harmony"
export DEVECO_SDK_HOME="$MAA_HARMONY_HOME/command-line-tools/sdk"
export DEVECO_NODE_HOME="$MAA_HARMONY_HOME/command-line-tools/tool/node"
export JAVA_HOME="$MAA_HARMONY_HOME/jdk21"
export HVIGOR_USER_HOME="$MAA_HARMONY_HOME/cache/hvigor"
export HDC="$DEVECO_SDK_HOME/default/openharmony/toolchains/hdc"
export TMPDIR="$MAA_HARMONY_HOME/tmp"
export npm_config_cache="$MAA_HARMONY_HOME/cache/npm"
export PATH="$JAVA_HOME/bin:$DEVECO_NODE_HOME/bin:$MAA_HARMONY_HOME/command-line-tools/bin:$DEVECO_SDK_HOME/default/openharmony/toolchains:$PATH"
